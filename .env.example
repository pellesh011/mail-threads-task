# Скопируйте этот файл в .env и укажите свою почту.
#
# От этой строки зависит, какие письма вам достанутся: у каждого кандидата
# свой набор данных. Эту же строку укажите первой строкой вашего README —
# по ней мы поймём, с чем сверять ваш результат.

CANDIDATE=ivan.petrov@gmail.com

# Параметры PostgreSQL. Если не заданы, используются эти значения по умолчанию.
POSTGRES_USER=worker
POSTGRES_PASSWORD=worker
POSTGRES_DB=mailthreads

# URL для подключения к базе. Используется локальным prisma CLI.
# Внутри контейнеров docker-compose подставляет своё значение.
DATABASE_URL=postgres://worker:worker@localhost:5432/mailthreads

# Для запуска без docker provider проброшен на localhost:8080.
# Внутри docker-compose подставляет своё значение.
PROVIDER_URL=http://localhost:8080

# Сколько независимых import-воркеров запускать внутри контейнера worker.
WORKER_CONCURRENCY=4
