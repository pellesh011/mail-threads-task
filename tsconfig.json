{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@mail-threads/shared": ["./package/shared/src/index.ts"]
    }
  },
  "include": [
    "prisma.config.ts",
    "package/shared/src",
    "worker/src",
    "exporter/src"
  ],
  "exclude": ["node_modules", "dist", "**/generated"]
}
