datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum TaskType {
  IMPORT_MESSAGES
  BUILD_THREADS
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Provider {
  id String @id @default(uuid())

  name String @unique

  messageRefs MessageReference[]
  threadRefs ThreadReference[]
  tasks Task[]
  rawMessages RawMessage[]
}

model Message {
  id String @id @default(uuid())

  sender String

  subject String?

  sentAt DateTime @db.Timestamptz

  //
  // Внутренняя связь сообщений
  //
  parentId String?

  parent Message? @relation("MessageParent", fields: [parentId], references: [id])
  children Message[] @relation("MessageParent")

  //
  // Текущий найденный thread
  //
  threadId String?

  thread Thread? @relation(fields: [threadId], references: [id])

  //
  // Внешние идентификаторы
  //
  refs MessageReference[]

  //
  // Ссылки на другие письма
  //
  outgoing MessageToMessageReference[] @relation("MessageOutgoing")
  incoming MessageToMessageReference[] @relation("MessageIncoming")

  //
  // Raw message, из которого был создан Message
  //
  rawMessage RawMessage?

  createdAt DateTime @default(now())
}

model MessageToMessageReference {
  id String @id @default(uuid())

  messageId String

  message Message @relation("MessageOutgoing", fields: [messageId], references: [id], onDelete: Cascade)

  referencedMessageId String

  referencedMessage Message @relation("MessageIncoming", fields: [referencedMessageId], references: [id], onDelete: Cascade)

  // 0-based position of the reference in the raw message's `references` list.
  // (Only explicit `references` become MessageToMessageReference rows;
  // `in_reply_to` is stored on the Message instead.)
  order Int

  @@unique([messageId, referencedMessageId])
}

model MessageReference {
  id String @id @default(uuid())

  messageId String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  providerId String

  provider Provider @relation(fields: [providerId], references: [id])

  externalId String

  @@unique([providerId, externalId])
}

model Thread {
  id String @id @default(uuid())

  subject String?

  messages Message[]
  refs ThreadReference[]

  createdAt DateTime @default(now())
}

model ThreadReference {
  id String @id @default(uuid())

  threadId String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  providerId String

  provider Provider @relation(fields: [providerId], references: [id])

  externalId String

  @@unique([providerId, externalId])
}

model Task {
  id String @id @default(uuid())

  providerId String

  provider Provider @relation(fields: [providerId], references: [id])

  type TaskType
  data Json
  cursor String?
  status TaskStatus
  startAt DateTime?
  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, cursor])
}

model RawMessage {
  id String @id @default(uuid())

  providerId String

  provider Provider @relation(fields: [providerId], references: [id])

  externalId String?

  payload Json

  receivedAt DateTime @default(now()) @db.Timestamptz

  processedAt DateTime? @db.Timestamptz

  messageId String? @unique

  message Message? @relation(fields: [messageId], references: [id])

  @@unique([providerId, externalId])
}
